{
  "name": "@jichong/dsh-doc-creator",
  "version": "1.0.0",
  "description": "Guided document authoring for DeepSeek Harness: templates or free-form, reference uploads, red-line rules, optional web research, versioned outlines, conversation-driven revisions, and Word/Markdown export",
  "license": "MIT",
  "author": "jichong-nj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jichong-nj/dsh-doc-creator.git"
  },
  "bugs": {
    "url": "https://github.com/jichong-nj/dsh-doc-creator/issues"
  },
  "homepage": "https://github.com/jichong-nj/dsh-doc-creator#readme",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node test/run-all.mjs",
    "prepare": "node build.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react-dom": "18.2.0"
  }
}
